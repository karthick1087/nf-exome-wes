/*
 * nf-exome-wes — Nextflow config
 * Generic WES germline pipeline (bcftools + GATK + clinical reports)
 */

manifest {
    name            = 'nf-exome-wes'
    author          = 'Exome Pipeline Team'
    homePage        = 'https://github.com/karthick1087/nf-exome-wes'
    description     = 'WES germline pipeline (bcftools + GATK) with clinical reports (results-bcftools / results-gatk layout)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

params {
    input              = null
    sample_id          = null
    sample_name        = null
    r1                 = null
    r2                 = null

    ref                = null
    exome_bed          = null
    reference_pool     = null

    pipeline           = 'bcftools'

    threads            = 16
    min_qual           = 30
    min_depth          = 10
    force              = false

    outdir             = 'results'
    publish_dir_mode   = 'copy'
    tracedir           = "${params.outdir}/pipeline_info"

    // Tool names on PATH (override with full paths if needed)
    samtools           = 'samtools'
    bcftools           = 'bcftools'
    bwa                = 'bwa'
    fastp              = 'fastp'
    gatk               = 'gatk'
    java               = 'java'
    tabix              = 'tabix'
    bgzip              = 'bgzip'

    clinical_res       = null
    known_sites_dir    = null
    dbsnp_bqsr         = null
    mills_indels       = null

    dbsnp_vcf          = null
    clinvar_vcf        = null
    gnomad_vcf         = null
    snpeff_jar         = null
    snpeff_data        = null
    snpeff_db          = 'hg38'
    snpeff_mem         = '4g'
    annovar_dir        = null
    annovar_humandb    = null

    omim_table         = "${projectDir}/assets/resources/use_omim_table.txt"
    skip_annotation    = false
    skip_annovar       = true
    skip_snpeff        = false

    max_memory         = '64.GB'
    max_cpus           = 32
    max_time           = '48.h'

    help               = false
    monochrome_logs    = false
}

process {
    cpus   = 2
    memory = 4.GB
    time   = 4.h

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low {
        cpus   = 2
        memory = 4.GB
        time   = 2.h
    }
    withLabel: process_medium {
        cpus   = { Math.min((params.threads as int), 8) }
        memory = 16.GB
        time   = 8.h
    }
    withLabel: process_high {
        cpus   = { Math.min((params.threads as int), 16) }
        memory = 32.GB
        time   = 24.h
    }
    withLabel: process_high_memory {
        cpus   = { Math.min((params.threads as int), 8) }
        memory = 48.GB
        time   = 12.h
    }

    withName: 'FASTP' {
        container = 'quay.io/biocontainers/fastp:0.23.4--h5f740d0_0'
    }
    withName: 'BWA_INDEX|BWA_MEM' {
        container = 'quay.io/biocontainers/mulled-v2-fe8faa35dbf6dc65a0f7f5d4ea12e31a79f73e40:219b6c713562084710c9f4bc34c4eb8c1a4d8f7e-0'
    }
    withName: 'BCFTOOLS_.*' {
        container = 'quay.io/biocontainers/bcftools:1.19--h8b25389_0'
    }
    withName: 'GATK_.*' {
        container = 'broadinstitute/gatk:4.6.1.0'
    }
    withName: 'SNPEFF_ANNOTATE' {
        container = 'quay.io/biocontainers/snpeff:5.2--hdfd78af_0'
    }
    withName: 'CLINICAL_REPORTS|COMPARE_PIPELINES' {
        container = null
    }
}

profiles {
    debug {
        dumpHashes           = true
        process.beforeScript = 'echo $HOSTNAME'
        cleanup              = false
    }

    conda {
        conda.enabled       = true
        conda.channels      = ['conda-forge', 'bioconda', 'defaults']
        process.conda       = "${projectDir}/environment.yml"
        docker.enabled      = false
        singularity.enabled = false
    }

    mamba {
        conda.enabled       = true
        conda.useMamba      = true
        process.conda       = "${projectDir}/environment.yml"
        docker.enabled      = false
        singularity.enabled = false
    }

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        conda.enabled       = false
        singularity.enabled = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }

    local {
        docker.enabled      = false
        singularity.enabled = false
        conda.enabled       = false
        process.executor    = 'local'
    }

    // Optional: prepend extra tool dirs from environment
    //   export NXF_EXTRA_PATH="/opt/gatk:/opt/conda/bin"
    lab {
        process.beforeScript = '''
            if [[ -n "${NXF_EXTRA_PATH:-}" ]]; then
                export PATH="${NXF_EXTRA_PATH}:$PATH"
            fi
            if [[ -n "${GATK_LOCAL_JAR:-}" ]]; then
                export GATK_LOCAL_JAR
            fi
        '''
    }

    slurm {
        process.executor = 'slurm'
        process.queue    = 'normal'
    }

    test {
        params.pipeline        = 'bcftools'
        params.threads         = 2
        params.max_cpus        = 2
        params.max_memory      = '6.GB'
        params.skip_annotation = true
    }

    // Threads and publish dir only. Reference files stay unset here.
    // main.nf picks up $HOME/reference/... when a param is empty and the file exists.
    site {
        params.threads    = 16
        params.outdir     = 'results'
        params.snpeff_db  = 'hg38'
        process.executor = 'local'
    }
}

includeConfig 'conf/modules.config'

timeline {
    enabled = true
    overwrite = true
    file    = "${params.tracedir}/execution_timeline.html"
}
report {
    enabled = true
    overwrite = true
    file    = "${params.tracedir}/execution_report.html"
}
trace {
    enabled = true
    overwrite = true
    file    = "${params.tracedir}/execution_trace.txt"
}
dag {
    enabled = true
    overwrite = true
    file    = "${params.tracedir}/pipeline_dag.html"
}
