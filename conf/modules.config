/*
 * Module overrides — report scripts need bin/ on PYTHONPATH
 * (Nextflow already puts bin/ on PATH for executables.)
 */
process {
    withName: 'CLINICAL_REPORTS|COMPARE_PIPELINES' {
        // clinical_disorder.py lives next to report scripts in bin/
        beforeScript = 'export PYTHONPATH="$(dirname $(which vcf_to_clinical_report.py 2>/dev/null || echo .)):${PYTHONPATH:-}"'
    }
}
